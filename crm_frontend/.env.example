# PUBLIC_INTERFACE
# Example environment for KAVIA CRM Frontend
# Update values per environment. Do not commit secrets.

# Backend HTTP base (e.g., http://localhost:3001 or /api if proxied)
REACT_APP_API_BASE=/api

# WebSocket base URL (e.g., ws://localhost:3001). Leave empty if using same origin WS path.
REACT_APP_WS_URL=ws://localhost:3001

# Feature flags to allow running without backend
# When false, HTTP calls are served from local mocks
REACT_APP_FEATURE_ENABLE_API=true
# When false, WebSocket hook emits mock messages on interval
REACT_APP_FEATURE_ENABLE_WS=true
