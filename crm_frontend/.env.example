# Example environment configuration for CRM Frontend (React)
# Copy this file to ".env" and adjust values as needed.
# Do not commit secrets.

# API base. Can be absolute (https://api.example.com/api/v1) or relative (/api/v1).
REACT_APP_API_BASE=/api/v1

# WebSocket base URL. If not set, it is derived from window.location (3000 -> 3001 mapping in dev).
REACT_APP_WS_URL=ws://localhost:3001

# Feature toggles for offline/mocked behavior
# When false, HTTP requests are served by local mocks so UI works without backend (including /auth/login, /auth/me, /auth/logout).
REACT_APP_FEATURE_ENABLE_API=true
# When false, the WebSocket hook emits mock messages periodically.
REACT_APP_FEATURE_ENABLE_WS=true

# DEV/DEMO ONLY: Dummy auth accepts any credentials and bypasses real auth endpoints.
# Set to false to use real backend authentication.
REACT_APP_FEATURE_DUMMY_AUTH=true
