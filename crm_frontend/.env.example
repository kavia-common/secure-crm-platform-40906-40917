# React Frontend Environment Example
# Copy this file to ".env" and adjust values for your environment.
# NOTE: Do not commit actual secrets.

# API base URL for the FastAPI backend:
# - Preferred: use absolute URL in deployment
# - Example absolute (local dev): http://localhost:3001/api/v1
# - Example absolute (deployment): https://vscode-internal-35219-beta.beta01.cloud.kavia.ai:3001/api/v1
# - If omitted, the app will try to compute: window.origin with port 3000→3001 + '/api/v1'
#   If your UI is served over HTTPS, ensure the API URL is also HTTPS or use a relative path to avoid mixed-content blocking.
REACT_APP_API_BASE=https://vscode-internal-35219-beta.beta01.cloud.kavia.ai:3001/api/v1

# Optional Axios timeout in milliseconds (default 15000)
REACT_APP_API_TIMEOUT_MS=15000

# WebSocket base URL (only used when feature is enabled)
# - Example dev: ws://localhost:3001
# - For TLS in deployment:
REACT_APP_WS_URL=wss://vscode-internal-35219-beta.beta01.cloud.kavia.ai:3001

# Feature flags:
# - When false, HTTP requests are served by local mocks so UI works without backend (including /auth/login, /auth/me, /auth/logout).
REACT_APP_FEATURE_ENABLE_API=true
REACT_APP_FEATURE_ENABLE_WS=true

# Tips:
# - If you see "Network blocked: Frontend is HTTPS but API is HTTP", change API to HTTPS or use a relative path and configure a dev proxy.
# - Ensure backend CORS allows your front-end origin (e.g., http://localhost:3000) and includes relevant headers (Authorization, Content-Type).
