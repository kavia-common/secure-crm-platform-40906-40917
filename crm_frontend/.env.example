# KAVIA CRM Frontend - .env.example
# -------------------------------------------------------------
# Demo mode (dummy auth) is ON by default. The app will auto-sign-in
# a mock user and bypass backend authentication routes.
# To turn OFF demo mode and use real backend auth, set:
#   REACT_APP_FEATURE_DUMMY_AUTH=false
# and ensure REACT_APP_API_BASE points to a reachable backend.
# -------------------------------------------------------------

# API base (absolute URL or relative). If left unset, the app uses
# window origin with dev mapping 3000->3001 and '/api/v1'.
REACT_APP_API_BASE=/api/v1

# WebSocket base. If unset, the app infers ws(s):// from window origin (3000->3001).
REACT_APP_WS_URL=ws://localhost:3001

# Feature toggles:
# When false, the app serves mock HTTP responses for common routes (customers, complaints, etc.).
REACT_APP_FEATURE_ENABLE_API=false
# When false, the app emits mock websocket messages for inbox/metrics.
REACT_APP_FEATURE_ENABLE_WS=false
# Dummy auth flag. Default is true internally; set false to use real backend auth.
REACT_APP_FEATURE_DUMMY_AUTH=true

# Optional environment knobs (not strictly required):
# REACT_APP_API_TIMEOUT_MS=15000
# REACT_APP_LOG_LEVEL=info
# REACT_APP_FRONTEND_URL=http://localhost:3000
# REACT_APP_BACKEND_URL=http://localhost:3001
# REACT_APP_PORT=3000
# REACT_APP_TRUST_PROXY=true
# REACT_APP_FEATURE_FLAGS=
# REACT_APP_EXPERIMENTS_ENABLED=false
